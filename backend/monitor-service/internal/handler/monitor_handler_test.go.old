// Helper функция для создания тестового контекста
func createTestContext() context.Context {
	return context.Background()
}

// TestCreateMonitor_Success тестирует успешное создание монитора.
func TestCreateMonitor_Success(t *testing.T) {
	// Создаём моки
	mockMonitorService := new(MockMonitorService)
	mockUptimeCalculator := new(MockUptimeCalculator)
	mockIncidentDetector := new(MockIncidentDetector)

	// Создаём handler
	handler := &MonitorHandler{
		monitorService:   mockMonitorService,
		uptimeCalculator: mockUptimeCalculator,
		incidentDetector: mockIncidentDetector,
		validator:        validator.New(),
	}

	// Подготавливаем тестовые данные
	ctx := createTestContext()
	monitorID := uuid.New().String()
	userID := "00000000-0000-0000-0000-000000000001" // Стаб от extractUserID

	expectedResp := &dto.MonitorResponse{
		ID:              monitorID,
		UserID:          userID,
		Name:            "Test Monitor",
		URL:             "https://example.com",
		CheckType:       "HTTP",
		IntervalSeconds: 60,
		TimeoutSeconds:  30,
		Status:          "PENDING",
		CreatedAt:       time.Now(),
		UpdatedAt:       time.Now(),
	}

	req := &monitov1.CreateMonitorRequest{
		Name:             "Test Monitor",
		Url:              "https://example.com",
		CheckType:        "HTTP",
		IntervalSeconds:  60,
		TimeoutSeconds:   30,
	}

	// Настраиваем ожидания моков
	mockMonitorService.On("CreateMonitor", mock.Anything, mock.AnythingOfType("*dto.CreateMonitorRequest")).Return(expectedResp, nil)

	// Выполняем запрос
	resp, err := handler.CreateMonitor(ctx, req)

	// Проверяем результаты
	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Equal(t, monitorID, resp.Monitor.Id)
	assert.Equal(t, "Test Monitor", resp.Monitor.Name)
	assert.Equal(t, "https://example.com", resp.Monitor.Url)
	assert.Equal(t, "PENDING", resp.Monitor.Status)

	// Проверяем, что моки были вызваны
	mockMonitorService.AssertExpectations(t)
}

// TestCreateMonitor_MissingAuth тестирует создание монитора без аутентификации.
func TestCreateMonitor_MissingAuth(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockUptimeCalculator := new(MockUptimeCalculator)
	mockIncidentDetector := new(MockIncidentDetector)

	handler := &MonitorHandler{
		monitorService:   mockMonitorService,
		uptimeCalculator: mockUptimeCalculator,
		incidentDetector: mockIncidentDetector,
		validator:        validator.New(),
	}

	// Контекст (extractUserID всегда возвращает стаб, так что auth всегда есть)
	ctx := context.Background()

	req := &monitov1.CreateMonitorRequest{
		Name:            "Test Monitor",
		Url:             "https://example.com",
		CheckType:       "HTTP",
		IntervalSeconds: 60,
		TimeoutSeconds:  30,
	}

	// Выполняем запрос
	resp, err := handler.CreateMonitor(ctx, req)

	// Проверяем результат - должен быть успех, так как extractUserID возвращает стаб
	assert.NoError(t, err)
	assert.NotNil(t, resp)
}

// TestCreateMonitor_ValidationError тестирует создание монитора с невалидными данными.
func TestCreateMonitor_ValidationError(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockUptimeCalculator := new(MockUptimeCalculator)
	mockIncidentDetector := new(MockIncidentDetector)

	handler := &MonitorHandler{
		monitorService:   mockMonitorService,
		uptimeCalculator: mockUptimeCalculator,
		incidentDetector: mockIncidentDetector,
		validator:        validator.New(),
	}

	ctx := createTestContext()

	tests := []struct {
		name    string
		req     *monitov1.CreateMonitorRequest
		wantErr string
	}{
		{
			name: "empty name",
			req: &monitov1.CreateMonitorRequest{
				Name:            "",
				Url:             "https://example.com",
				IntervalSeconds: 60,
			},
			wantErr: "validation failed",
		},
		{
			name: "empty url",
			req: &monitov1.CreateMonitorRequest{
				Name:            "Test",
				Url:             "",
				IntervalSeconds: 60,
			},
			wantErr: "validation failed",
		},
		{
			name: "zero interval",
			req: &monitov1.CreateMonitorRequest{
				Name:            "Test",
				Url:             "https://example.com",
				IntervalSeconds: 0,
			},
			wantErr: "validation failed",
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			resp, err := handler.CreateMonitor(ctx, tt.req)

			assert.Error(t, err)
			assert.Nil(t, resp)
			assert.Contains(t, err.Error(), tt.wantErr)
			assert.Equal(t, codes.InvalidArgument, status.Code(err))

			mockMonitorService.AssertNotCalled(t, "CreateMonitor", mock.Anything, mock.Anything)
		})
	}
}

// TestCreateMonitor_ServiceError тестирует обработку ошибок от сервиса.
func TestCreateMonitor_ServiceError(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Free")

	req := &monitov1.CreateMonitorRequest{
		Name:            "Test Monitor",
		Url:             "https://example.com",
		CheckType:       "HTTP",
		IntervalSeconds: 60,
		TimeoutSeconds:  30,
	}

	tests := []struct {
		name       string
		serviceErr error
		wantCode   codes.Code
	}{
		{
			name:       "monitor already exists",
			serviceErr: interfaces.ErrMonitorAlreadyExists,
			wantCode:   codes.AlreadyExists,
		},
		{
			name:       "monitor limit reached",
			serviceErr: apperrors.ErrMonitorLimitReached,
			wantCode:   codes.ResourceExhausted,
		},
		{
			name:       "unknown tier",
			serviceErr: apperrors.ErrUnknownTier,
			wantCode:   codes.Internal,
		},
		{
			name:       "internal error",
			serviceErr: stderrors.New("internal error"),
			wantCode:   codes.Internal,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Free", nil)
			mockMonitorService.On("CreateMonitor", mock.Anything, mock.Anything).Return(nil, tt.serviceErr)

			resp, err := handler.CreateMonitor(ctx, req)

			assert.Error(t, err)
			assert.Nil(t, resp)
			assert.Equal(t, tt.wantCode, status.Code(err))

			mockAuthClient.AssertExpectations(t)
			mockMonitorService.AssertExpectations(t)

			// Ресет моков для следующего теста
			mockAuthClient.ExpectedCalls = nil
			mockMonitorService.ExpectedCalls = nil
		})
	}
}

// TestHelperFunctions тестирует вспомогательные функции.
func TestHelperFunctions(t *testing.T) {
	t.Run("intPtr", func(t *testing.T) {
		tests := []struct {
			name  string
			input int32
			want  *int
		}{
			{"zero value", 0, nil},
			{"positive value", 100, func() *int { v := 100; return &v }()},
			{"negative value", -50, func() *int { v := -50; return &v }()},
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				got := intPtr(tt.input)
				if tt.want == nil {
					assert.Nil(t, got)
				} else {
					assert.NotNil(t, got)
					assert.Equal(t, *tt.want, *got)
				}
			})
		}
	})

	t.Run("int32Ptr", func(t *testing.T) {
		tests := []struct {
			name  string
			input int
			want  *int32
		}{
			{"zero value", 0, nil},
			{"positive value", 100, func() *int32 { v := int32(100); return &v }()},
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				got := int32Ptr(tt.input)
				if tt.want == nil {
					assert.Nil(t, got)
				} else {
					assert.NotNil(t, got)
					assert.Equal(t, *tt.want, *got)
				}
			})
		}
	})

	t.Run("stringPtr", func(t *testing.T) {
		tests := []struct {
			name  string
			input string
			want  *string
		}{
			{"empty string", "", nil},
			{"non-empty string", "test", func() *string { v := "test"; return &v }()},
		}
		for _, tt := range tests {
			t.Run(tt.name, func(t *testing.T) {
				got := stringPtr(tt.input)
				if tt.want == nil {
					assert.Nil(t, got)
				} else {
					assert.NotNil(t, got)
					assert.Equal(t, *tt.want, *got)
				}
			})
		}
	})
}

// TestGetMonitor_Success тестирует успешное получение монитора.
func TestGetMonitor_Success(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	monitorID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	expectedResp := &dto.MonitorResponse{
		ID:              monitorID,
		UserID:          userID,
		Name:            "Test Monitor",
		URL:             "https://example.com",
		CheckType:       "HTTP",
		IntervalSeconds: 60,
		TimeoutSeconds:  30,
		Status:          "UP",
		CreatedAt:       time.Now(),
		UpdatedAt:       time.Now(),
	}

	req := &monitov1.GetMonitorRequest{
		Id: monitorID,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockMonitorService.On("GetMonitor", mock.Anything, monitorID, userID).Return(expectedResp, nil)

	resp, err := handler.GetMonitor(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Equal(t, monitorID, resp.Monitor.Id)
	assert.Equal(t, "Test Monitor", resp.Monitor.Name)
	assert.Equal(t, "UP", resp.Monitor.Status)

	mockAuthClient.AssertExpectations(t)
	mockMonitorService.AssertExpectations(t)
}

// TestGetMonitor_NotFound тестирует получение несуществующего монитора.
