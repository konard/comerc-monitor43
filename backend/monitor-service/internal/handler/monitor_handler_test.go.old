// TestGetUptimeStats_Success тестирует успешное получение статистики uptime.
func TestGetUptimeStats_Success(t *testing.T) {
	mockUptimeCalculator := new(MockUptimeCalculator)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		uptimeCalculator: mockUptimeCalculator,
		authClient:       mockAuthClient,
		validator:        validator.New(),
	}

	userID := uuid.New().String()
	monitorID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	from := time.Now().Add(-24 * time.Hour)
	to := time.Now()

	expectedResp := &dto.UptimeStatsResponse{
		Uptime:              99.5,
		TotalChecks:         1000,
		UpChecks:            995,
		DegradedChecks:      3,
		DownChecks:          2,
		PausedChecks:        0,
		TotalDowntime:       120,
		AverageResponseTime: 150,
		Incidents:           2,
		Note:                "Good uptime",
	}

	req := &monitov1.GetUptimeStatsRequest{
		MonitorId: monitorID,
		From:      timestamppb.New(from),
		To:        timestamppb.New(to),
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockUptimeCalculator.On("CalculateUptime", mock.Anything, mock.AnythingOfType("*dto.GetUptimeStatsRequest")).Return(expectedResp, nil)

	resp, err := handler.GetUptimeStats(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Equal(t, float64(99.5), resp.Uptime)
	assert.Equal(t, int32(1000), resp.TotalChecks)
	assert.Equal(t, int32(995), resp.UpChecks)
	assert.Equal(t, int32(2), resp.Incidents)

	mockAuthClient.AssertExpectations(t)
	mockUptimeCalculator.AssertExpectations(t)
}

