// TestMonitorHandler_HandleError тестирует handleError метод.
func TestMonitorHandler_HandleError(t *testing.T) {
	handler := &MonitorHandler{}

	tests := []struct {
		name         string
		err          error
		expectedCode codes.Code
	}{
		{
			name:         "ErrMonitorNotFound",
			err:          interfaces.ErrMonitorNotFound,
			expectedCode: codes.NotFound,
		},
		{
			name:         "ErrMonitorAlreadyExists",
			err:          interfaces.ErrMonitorAlreadyExists,
			expectedCode: codes.AlreadyExists,
		},
		{
			name:         "wrapped ErrMonitorNotFound",
			err:          errors.Wrap(interfaces.ErrMonitorNotFound, "not found in repo"),
			expectedCode: codes.NotFound,
		},
		{
			name:         "unknown error",
			err:          stderrors.New("unknown error"),
			expectedCode: codes.Internal,
		},
		{
			name:         "nil error",
			err:          nil,
			expectedCode: codes.Internal,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := handler.handleError(tt.err)
			assert.Error(t, err)
			assert.Equal(t, tt.expectedCode, status.Code(err))
		})
	}
}

// TestListMonitors_Success тестирует успешное получение списка мониторов.
func TestListMonitors_Success(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	monitorID1 := uuid.New().String()
	monitorID2 := uuid.New().String()

	expectedResp := &dto.ListMonitorsResponse{
		Monitors: []*dto.MonitorResponse{
			{
				ID:              monitorID1,
				UserID:          userID,
				Name:            "Monitor 1",
				URL:             "https://example1.com",
				CheckType:       "HTTP",
				IntervalSeconds: 60,
				TimeoutSeconds:  30,
				Status:          "UP",
				CreatedAt:       time.Now(),
				UpdatedAt:       time.Now(),
			},
			{
				ID:              monitorID2,
				UserID:          userID,
				Name:            "Monitor 2",
				URL:             "https://example2.com",
				CheckType:       "HTTP",
				IntervalSeconds: 120,
				TimeoutSeconds:  30,
				Status:          "DOWN",
				CreatedAt:       time.Now(),
				UpdatedAt:       time.Now(),
			},
		},
		Total:  2,
		Limit:  100,
		Offset: 0,
	}

	req := &monitov1.ListMonitorsRequest{
		Limit:  100,
		Offset: 0,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockMonitorService.On("ListMonitors", mock.Anything, mock.AnythingOfType("*dto.ListMonitorsRequest")).Return(expectedResp, nil)

	resp, err := handler.ListMonitors(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Len(t, resp.Monitors, 2)
	assert.Equal(t, int32(2), resp.Total)
	assert.Equal(t, "Monitor 1", resp.Monitors[0].Name)
	assert.Equal(t, "Monitor 2", resp.Monitors[1].Name)

	mockAuthClient.AssertExpectations(t)
	mockMonitorService.AssertExpectations(t)
}

// TestListMonitors_WithFilter тестирует получение списка мониторов с фильтром по статусу.
func TestListMonitors_WithFilter(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	expectedResp := &dto.ListMonitorsResponse{
		Monitors: []*dto.MonitorResponse{
			{
				ID:              uuid.New().String(),
				UserID:          userID,
				Name:            "Down Monitor",
				URL:             "https://example.com",
				CheckType:       "HTTP",
				IntervalSeconds: 60,
				TimeoutSeconds:  30,
				Status:          "DOWN",
				CreatedAt:       time.Now(),
				UpdatedAt:       time.Now(),
			},
		},
		Total:  1,
		Limit:  100,
		Offset: 0,
	}

	req := &monitov1.ListMonitorsRequest{
		Status: "DOWN",
		Limit:  100,
		Offset: 0,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockMonitorService.On("ListMonitors", mock.Anything, mock.MatchedBy(func(r *dto.ListMonitorsRequest) bool {
		return r.Status == "DOWN" && r.Limit == 100 && r.Offset == 0
	})).Return(expectedResp, nil)

	resp, err := handler.ListMonitors(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Len(t, resp.Monitors, 1)
	assert.Equal(t, "DOWN", resp.Monitors[0].Status)

	mockAuthClient.AssertExpectations(t)
	mockMonitorService.AssertExpectations(t)
}

// TestListMonitors_DefaultLimit тестирует применение дефолтного лимита.
func TestListMonitors_DefaultLimit(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	expectedResp := &dto.ListMonitorsResponse{
		Monitors: []*dto.MonitorResponse{},
		Total:    0,
		Limit:    100,
		Offset:   0,
	}

	req := &monitov1.ListMonitorsRequest{
		Limit:  0, // Должен быть заменён на 100
		Offset: 0,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockMonitorService.On("ListMonitors", mock.Anything, mock.MatchedBy(func(r *dto.ListMonitorsRequest) bool {
		return r.Limit == 100 && r.Offset == 0
	})).Return(expectedResp, nil)

	resp, err := handler.ListMonitors(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Equal(t, int32(100), resp.Limit)

	mockAuthClient.AssertExpectations(t)
	mockMonitorService.AssertExpectations(t)
}

// TestDtoToProto тестирует конвертацию DTO в Proto.
func TestDtoToProto(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts basic monitor", func(t *testing.T) {
		now := time.Now()
		dtoResp := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          "user-123",
			Name:            "Test Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			CreatedAt:       now,
			UpdatedAt:       now,
		}

		protoResp := handler.dtoToProto(dtoResp)

		assert.Equal(t, dtoResp.ID, protoResp.Id)
		assert.Equal(t, dtoResp.UserID, protoResp.UserId)
		assert.Equal(t, dtoResp.Name, protoResp.Name)
		assert.Equal(t, dtoResp.URL, protoResp.Url)
		assert.Equal(t, dtoResp.CheckType, protoResp.CheckType)
		assert.Equal(t, int32(60), protoResp.IntervalSeconds)
		assert.Equal(t, int32(30), protoResp.TimeoutSeconds)
		assert.Equal(t, dtoResp.Status, protoResp.Status)
	})

	t.Run("converts monitor with optional fields", func(t *testing.T) {
		threshold := 1000
		failureRate := 50
		lastCheck := time.Now()

		dtoResp := &dto.MonitorResponse{
			ID:                             uuid.New().String(),
			UserID:                         "user-123",
			Name:                           "Test Monitor",
			URL:                            "https://example.com",
			CheckType:                      "HTTP",
			IntervalSeconds:                60,
			TimeoutSeconds:                 30,
			Status:                         "DEGRADED",
			LastCheckAt:                    &lastCheck,
			DegradedResponseTimeThreshold:  &threshold,
			DegradedFailureRateThreshold:   &failureRate,
			CreatedAt:                      time.Now(),
			UpdatedAt:                      time.Now(),
		}

		protoResp := handler.dtoToProto(dtoResp)

		assert.Equal(t, int32(1000), protoResp.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(50), protoResp.DegradedFailureRateThreshold)
		assert.True(t, protoResp.LastCheckAt.IsValid())
	})

	t.Run("converts monitor with working hours", func(t *testing.T) {
		start := "09:00"
		end := "18:00"

		dtoResp := &dto.MonitorResponse{
			ID:                uuid.New().String(),
			UserID:            "user-123",
			Name:              "Business Hours Monitor",
			URL:               "https://example.com",
			CheckType:         "HTTP",
			IntervalSeconds:   300,
			TimeoutSeconds:    30,
			Status:            "UP",
			WorkingHoursStart: &start,
			WorkingHoursEnd:   &end,
			WorkingDays:       []string{"Mon", "Tue", "Wed", "Thu", "Fri"},
			CreatedAt:         time.Now(),
			UpdatedAt:         time.Now(),
		}

		protoResp := handler.dtoToProto(dtoResp)

		assert.Equal(t, "09:00", protoResp.WorkingHoursStart)
		assert.Equal(t, "18:00", protoResp.WorkingHoursEnd)
		assert.Len(t, protoResp.WorkingDays, 5)
	})

	t.Run("converts monitor without optional fields", func(t *testing.T) {
		dtoResp := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          "user-123",
			Name:            "Minimal Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "PENDING",
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoResp := handler.dtoToProto(dtoResp)

		assert.Equal(t, int32(0), protoResp.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(0), protoResp.DegradedFailureRateThreshold)
		assert.False(t, protoResp.LastCheckAt.IsValid())
	})
}

// TestUpdateMonitor_Success тестирует успешное обновление монитора.
func TestUpdateMonitor_Success(t *testing.T) {
	mockMonitorService := new(MockMonitorService)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		monitorService: mockMonitorService,
		authClient:     mockAuthClient,
		validator:      validator.New(),
	}

	userID := uuid.New().String()
	monitorID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	newName := "Updated Monitor"
	newURL := "https://updated.com"

	expectedResp := &dto.MonitorResponse{
		ID:              monitorID,
		UserID:          userID,
		Name:            newName,
		URL:             newURL,
		CheckType:       "HTTP",
		IntervalSeconds: 120,
		TimeoutSeconds:  30,
		Status:          "UP",
		CreatedAt:       time.Now(),
		UpdatedAt:       time.Now(),
	}

	req := &monitov1.UpdateMonitorRequest{
		Id:              monitorID,
		Name:            &newName,
		Url:             &newURL,
		IntervalSeconds: 120,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockMonitorService.On("UpdateMonitor", mock.Anything, mock.AnythingOfType("*dto.UpdateMonitorRequest")).Return(expectedResp, nil)

	resp, err := handler.UpdateMonitor(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Equal(t, newName, resp.Monitor.Name)
	assert.Equal(t, newURL, resp.Monitor.Url)
	assert.Equal(t, int32(120), resp.Monitor.IntervalSeconds)

	mockAuthClient.AssertExpectations(t)
	mockMonitorService.AssertExpectations(t)
}

