// TestCheckResultDtoToProto тестирует конвертацию CheckResult.
func TestCheckResultDtoToProto(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts check result with all fields", func(t *testing.T) {
		responseTimeMs := 250
		statusCode := 200

		dtoResp := &dto.CheckResultResponse{
			ID:             uuid.New().String(),
			MonitorID:      uuid.New().String(),
			Status:         "UP",
			ResponseTimeMs: &responseTimeMs,
			StatusCode:     &statusCode,
			CheckedAt:      time.Now(),
			CreatedAt:      time.Now(),
		}

		protoResp := handler.checkResultDtoToProto(dtoResp)

		assert.Equal(t, dtoResp.ID, protoResp.Id)
		assert.Equal(t, dtoResp.MonitorID, protoResp.MonitorId)
		assert.Equal(t, dtoResp.Status, protoResp.Status)
		assert.Equal(t, int32(250), protoResp.ResponseTimeMs)
		assert.Equal(t, int32(200), protoResp.StatusCode)
	})

	t.Run("converts check result with error", func(t *testing.T) {
		errorMsg := "connection timeout"

		dtoResp := &dto.CheckResultResponse{
			ID:           uuid.New().String(),
			MonitorID:    uuid.New().String(),
			Status:       "DOWN",
			ErrorMessage: &errorMsg,
			CheckedAt:    time.Now(),
			CreatedAt:    time.Now(),
		}

		protoResp := handler.checkResultDtoToProto(dtoResp)

		assert.Equal(t, "DOWN", protoResp.Status)
		assert.Equal(t, "connection timeout", protoResp.ErrorMessage)
	})

	t.Run("converts check result without optional fields", func(t *testing.T) {
		dtoResp := &dto.CheckResultResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			Status:    "PENDING",
			CheckedAt: time.Now(),
			CreatedAt: time.Now(),
		}

		protoResp := handler.checkResultDtoToProto(dtoResp)

		assert.Equal(t, "PENDING", protoResp.Status)
		assert.Equal(t, int32(0), protoResp.ResponseTimeMs)
		assert.Equal(t, int32(0), protoResp.StatusCode)
		assert.Equal(t, "", protoResp.ErrorMessage)
	})
}

// TestGetMonitorHistory_Success тестирует успешное получение истории проверок.
func TestGetMonitorHistory_Success(t *testing.T) {
	mockUptimeCalculator := new(MockUptimeCalculator)
	mockAuthClient := new(MockAuthClient)

	handler := &MonitorHandler{
		uptimeCalculator: mockUptimeCalculator,
		authClient:       mockAuthClient,
		validator:        validator.New(),
	}

	userID := uuid.New().String()
	monitorID := uuid.New().String()
	ctx := createContextWithAuth(userID, "Pro")

	from := time.Now().Add(-24 * time.Hour)
	to := time.Now()

	responseTime := int(250)
	statusCode := int(200)

	expectedResp := &dto.GetMonitorHistoryResponse{
		Results: []*dto.CheckResultResponse{
			{
				ID:             uuid.New().String(),
				MonitorID:      monitorID,
				Status:         "UP",
				ResponseTimeMs: &responseTime,
				StatusCode:     &statusCode,
				CheckedAt:      from,
				CreatedAt:      from,
			},
		},
		Total:  1,
		Limit:  100,
		Offset: 0,
	}

	req := &monitov1.GetMonitorHistoryRequest{
		MonitorId: monitorID,
		From:      timestamppb.New(from),
		To:        timestamppb.New(to),
		Limit:     100,
		Offset:    0,
	}

	mockAuthClient.On("ValidateTokenWithTier", mock.Anything, "test-token").Return(userID, "Pro", nil)
	mockUptimeCalculator.On("GetMonitorHistory", mock.Anything, mock.AnythingOfType("*dto.GetMonitorHistoryRequest")).Return(expectedResp, nil)

	resp, err := handler.GetMonitorHistory(ctx, req)

	assert.NoError(t, err)
	assert.NotNil(t, resp)
	assert.Len(t, resp.Results, 1)
	assert.Equal(t, "UP", resp.Results[0].Status)
	assert.Equal(t, int32(250), resp.Results[0].ResponseTimeMs)
	assert.Equal(t, int32(200), resp.Results[0].StatusCode)

	mockAuthClient.AssertExpectations(t)
	mockUptimeCalculator.AssertExpectations(t)
}

