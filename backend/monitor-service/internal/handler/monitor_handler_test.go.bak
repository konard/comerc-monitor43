// TestNewMonitorHandler тестирует создание MonitorHandler.
func TestNewMonitorHandler(t *testing.T) {
	// Note: NewMonitorHandler требует реальные сервисы
	// Проверяем только структуру
	assert.NotNil(t, &MonitorHandler{})
}

// TestMonitorHandler_ErrorHandling тестирует обработку ошибок в handlers.
func TestMonitorHandler_ErrorHandling(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles ErrMonitorNotFound", func(t *testing.T) {
		err := handler.handleError(interfaces.ErrMonitorNotFound)
		assert.Error(t, err)
		assert.Equal(t, codes.NotFound, status.Code(err))
	})

	t.Run("handles ErrMonitorAlreadyExists", func(t *testing.T) {
		err := handler.handleError(interfaces.ErrMonitorAlreadyExists)
		assert.Error(t, err)
		assert.Equal(t, codes.AlreadyExists, status.Code(err))
	})

	t.Run("handles unknown error", func(t *testing.T) {
		unknownErr := stderrors.New("unknown error")
		err := handler.handleError(unknownErr)
		assert.Error(t, err)
		assert.Equal(t, codes.Internal, status.Code(err))
	})
}

// TestHelperFunctions тестирует helper функции.
func TestHelperFunctions(t *testing.T) {
	t.Run("intPtr with non-zero value", func(t *testing.T) {
		result := intPtr(100)
		assert.NotNil(t, result)
		assert.Equal(t, 100, *result)
	})

	t.Run("intPtr with zero value", func(t *testing.T) {
		result := intPtr(0)
		assert.Nil(t, result)
	})

	t.Run("int32Ptr", func(t *testing.T) {
		result := int32Ptr(42)
		assert.NotNil(t, result)
		assert.Equal(t, int32(42), *result)

		result = int32Ptr(0)
		assert.Nil(t, result)
	})

	t.Run("stringPtr with non-empty string", func(t *testing.T) {
		result := stringPtr("test")
		assert.NotNil(t, result)
		assert.Equal(t, "test", *result)
	})

	t.Run("stringPtr with empty string", func(t *testing.T) {
		result := stringPtr("")
		assert.Nil(t, result)
	})
}

