// TestMonitorHandler_ExtractUserID тестирует извлечение user ID.
func TestMonitorHandler_ExtractUserID(t *testing.T) {
	t.Run("successfully extracts user ID from valid token", func(t *testing.T) {
		mockAuthClient := new(MockAuthClient)
		handler := &MonitorHandler{
			authClient: mockAuthClient,
		}

		expectedUserID := "user-123"
		mockAuthClient.On("ValidateToken", mock.Anything, "valid-jwt-token").Return(expectedUserID, nil)

		ctx := context.Background()
		ctx = metadata.NewIncomingContext(ctx, metadata.Pairs("authorization", "Bearer valid-jwt-token"))

		userID, err := handler.extractUserID(ctx)

		assert.NoError(t, err)
		assert.Equal(t, expectedUserID, userID)
		mockAuthClient.AssertExpectations(t)
	})

	t.Run("returns error when authorization header is missing", func(t *testing.T) {
		mockAuthClient := new(MockAuthClient)
		handler := &MonitorHandler{
			authClient: mockAuthClient,
		}

		ctx := context.Background()

		userID, err := handler.extractUserID(ctx)

		assert.Error(t, err)
		assert.Equal(t, codes.Unauthenticated, status.Code(err))
		assert.Empty(t, userID)
	})

	t.Run("returns error when authorization header format is invalid", func(t *testing.T) {
		mockAuthClient := new(MockAuthClient)
		handler := &MonitorHandler{
			authClient: mockAuthClient,
		}

		ctx := context.Background()
		ctx = metadata.NewIncomingContext(ctx, metadata.Pairs("authorization", "InvalidFormat token"))

		userID, err := handler.extractUserID(ctx)

		assert.Error(t, err)
		assert.Equal(t, codes.Unauthenticated, status.Code(err))
		assert.Empty(t, userID)
	})

	t.Run("returns error when token validation fails", func(t *testing.T) {
		mockAuthClient := new(MockAuthClient)
		handler := &MonitorHandler{
			authClient: mockAuthClient,
		}

		mockAuthClient.On("ValidateToken", mock.Anything, "invalid-token").Return("", status.Error(codes.Unauthenticated, "invalid token"))

		ctx := context.Background()
		ctx = metadata.NewIncomingContext(ctx, metadata.Pairs("authorization", "Bearer invalid-token"))

		userID, err := handler.extractUserID(ctx)

		assert.Error(t, err)
		assert.Equal(t, codes.Unauthenticated, status.Code(err))
		assert.Empty(t, userID)
		mockAuthClient.AssertExpectations(t)
	})
}

// TestMonitorHandler_GetMonitor_MissingID тестирует отсутствие ID.
func TestMonitorHandler_GetMonitor_MissingID(t *testing.T) {
	handler := &MonitorHandler{}

