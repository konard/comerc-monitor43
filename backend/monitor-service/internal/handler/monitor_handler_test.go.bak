}

// TestMonitorHandler_StatusCodes тестирует коды статусов gRPC.
func TestMonitorHandler_StatusCodes(t *testing.T) {
	t.Run("NotFound status", func(t *testing.T) {
		st := status.Error(codes.NotFound, "monitor not found")
		assert.Equal(t, codes.NotFound, status.Code(st))
	})

	t.Run("AlreadyExists status", func(t *testing.T) {
		st := status.Error(codes.AlreadyExists, "monitor already exists")
		assert.Equal(t, codes.AlreadyExists, status.Code(st))
	})

	t.Run("InvalidArgument status", func(t *testing.T) {
		st := status.Error(codes.InvalidArgument, "validation failed")
		assert.Equal(t, codes.InvalidArgument, status.Code(st))
	})

	t.Run("Internal status", func(t *testing.T) {
		st := status.Error(codes.Internal, "internal server error")
		assert.Equal(t, codes.Internal, status.Code(st))
	})
}

// TestMonitorHandler_DefaultLimit тестирует логику лимита по умолчанию.
func TestMonitorHandler_DefaultLimit(t *testing.T) {
	testCases := []struct {
		name     string
		input    int
		expected int
	}{
		{"zero value", 0, 100},
		{"negative value", -1, 100},
		{"positive value", 50, 50},
		{"large value", 1000, 1000},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			limit := tc.input
			if limit <= 0 {
				limit = 100
			}
			assert.Equal(t, tc.expected, limit)
		})
	}
}

// TestMonitorHandler_RequestStructures тестирует структуры запросов.
func TestMonitorHandler_RequestStructures(t *testing.T) {
	t.Run("CreateMonitorRequest", func(t *testing.T) {
		req := &monitov1.CreateMonitorRequest{
			Name:             "Test Monitor",
			Url:              "https://example.com",
			CheckType:         "HTTP",
			IntervalSeconds:  60,
			TimeoutSeconds:   30,
			WorkingDays:      []string{"Mon", "Tue", "Wed", "Thu", "Fri"},
		}

		assert.Equal(t, "Test Monitor", req.Name)
		assert.Equal(t, "https://example.com", req.Url)
		assert.Equal(t, int32(60), req.IntervalSeconds)
		assert.Len(t, req.WorkingDays, 5)
	})

	t.Run("ListMonitorsRequest", func(t *testing.T) {
		req := &monitov1.ListMonitorsRequest{
			Status: "UP",
			Limit:  100,
			Offset: 0,
		}

		assert.Equal(t, "UP", req.Status)
		assert.Equal(t, int32(100), req.Limit)
		assert.Equal(t, int32(0), req.Offset)
	})
}

