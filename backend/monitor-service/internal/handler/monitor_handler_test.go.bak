	}
}

// TestMonitorHandler_TimestampHandling тестирует обработку временных меток.
func TestMonitorHandler_TimestampHandling(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles UTC timestamps", func(t *testing.T) {
		now := time.Now().UTC()

		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "UTC Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			CreatedAt:       now,
			UpdatedAt:       now,
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)
		assert.NotNil(t, protoMonitor.CreatedAt)
		assert.NotNil(t, protoMonitor.UpdatedAt)
	})

	t.Run("handles nil LastCheckAt", func(t *testing.T) {
		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Never Checked Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "PENDING",
			LastCheckAt:     nil,
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)
		assert.False(t, protoMonitor.LastCheckAt.IsValid())
	})

	t.Run("handles old and recent timestamps", func(t *testing.T) {
		oldTime := time.Now().Add(-30 * 24 * time.Hour) // 30 days ago
		recentTime := time.Now().Add(-1 * time.Minute)  // 1 minute ago

		dtoResult := &dto.CheckResultResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			Status:    "UP",
			CheckedAt: oldTime,
			CreatedAt: recentTime,
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)
		assert.NotNil(t, protoResult.CheckedAt)
		assert.NotNil(t, protoResult.CreatedAt)
	})
}

// TestMonitorHandler_RequestResponseFlow тестирует полный цикл запрос-ответ.
func TestMonitorHandler_RequestResponseFlow(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("CreateMonitorRequest to DTO conversion", func(t *testing.T) {
		userID := uuid.New().String()
		req := &monitov1.CreateMonitorRequest{
			Name:            "Flow Test Monitor",
			Url:             "https://flow-test.com",
			CheckType:       "HTTP",
			IntervalSeconds: 120,
			TimeoutSeconds:  60,
		}

		// Simulate the conversion that happens in CreateMonitor
		createReq := &dto.CreateMonitorRequest{
			UserID:          userID,
			Name:            req.Name,
			URL:             req.Url,
			CheckType:       req.CheckType,
			IntervalSeconds: int(req.IntervalSeconds),
			TimeoutSeconds:  int(req.TimeoutSeconds),
		}

		assert.Equal(t, "Flow Test Monitor", createReq.Name)
		assert.Equal(t, "https://flow-test.com", createReq.URL)
		assert.Equal(t, 120, createReq.IntervalSeconds)
		assert.Equal(t, 60, createReq.TimeoutSeconds)
	})

	t.Run("ListMonitorsRequest to DTO conversion", func(t *testing.T) {
		userID := uuid.New().String()
		req := &monitov1.ListMonitorsRequest{
			Status: "UP",
			Limit:  50,
			Offset: 10,
		}

		// Simulate the conversion that happens in ListMonitors
		listReq := &dto.ListMonitorsRequest{
			UserID: userID,
			Status: req.Status,
			Limit:  int(req.Limit),
			Offset: int(req.Offset),
		}

		if listReq.Limit <= 0 {
			listReq.Limit = 100
		}

		assert.Equal(t, "UP", listReq.Status)
		assert.Equal(t, 50, listReq.Limit)
		assert.Equal(t, 10, listReq.Offset)
	})

	t.Run("DTO to protobuf conversion for response", func(t *testing.T) {
		dtoResp := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Response Test",
			URL:             "https://response-test.com",
			CheckType:       "HTTP",
			IntervalSeconds: 180,
			TimeoutSeconds:  45,
			Status:          "UP",
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoResp := handler.dtoToProto(dtoResp)

		assert.Equal(t, "Response Test", protoResp.Name)
		assert.Equal(t, "https://response-test.com", protoResp.Url)
		assert.Equal(t, "UP", protoResp.Status)
		assert.Equal(t, int32(180), protoResp.IntervalSeconds)
		assert.Equal(t, int32(45), protoResp.TimeoutSeconds)
	})
}

// TestMonitorHandler_ErrorCodeMapping тестирует отображение кодов ошибок.
func TestMonitorHandler_ErrorCodeMapping(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("maps domain errors to gRPC codes", func(t *testing.T) {
		errorMappings := []struct {
			name           string
			domainError    error
			expectedCode   codes.Code
			shouldContain  string
		}{
			{
				name:          "ErrMonitorNotFound",
				domainError:   interfaces.ErrMonitorNotFound,
				expectedCode:  codes.NotFound,
				shouldContain: "not found",
			},
			{
				name:          "ErrMonitorAlreadyExists",
				domainError:   interfaces.ErrMonitorAlreadyExists,
				expectedCode:  codes.AlreadyExists,
				shouldContain: "already exists",
			},
			{
				name:          "ErrMonitorNameInvalid",
				domainError:   pkgerrors.ErrMonitorNameInvalid,
				expectedCode:  codes.Internal,
				shouldContain: "internal server error",
			},
			{
				name:          "ErrMonitorURLInvalid",
				domainError:   pkgerrors.ErrMonitorURLInvalid,
				expectedCode:  codes.Internal,
				shouldContain: "internal server error",
			},
		}

		for _, tc := range errorMappings {
			t.Run(tc.name, func(t *testing.T) {
				err := handler.handleError(tc.domainError)
				require.Error(t, err)
				assert.Equal(t, tc.expectedCode, status.Code(err))
				assert.Contains(t, status.Convert(err).Message(), tc.shouldContain)
			})
		}
	})
}

// TestMonitorHandler_CompleteFlow тестирует полные потоки данных.
func TestMonitorHandler_CompleteFlow(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("full monitor data flow", func(t *testing.T) {
		// Simulate creating a monitor from request to response
		createReq := &monitov1.CreateMonitorRequest{
			Name:            "Full Flow Monitor",
			Url:             "https://full-flow.com",
			CheckType:       "HTTPS",
			IntervalSeconds: 300,
			TimeoutSeconds:  90,
			WorkingDays:     []string{"Mon", "Wed", "Fri"},
		}

		// Convert to DTO (as handler would do)
		userID := uuid.New().String()
		createDTO := &dto.CreateMonitorRequest{
			UserID:          userID,
			Name:            createReq.Name,
			URL:             createReq.Url,
			CheckType:       createReq.CheckType,
			IntervalSeconds: int(createReq.IntervalSeconds),
			TimeoutSeconds:  int(createReq.TimeoutSeconds),
			WorkingDays:     createReq.WorkingDays,
		}

		// Simulate service response
		serviceResp := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          userID,
			Name:            createDTO.Name,
			URL:             createDTO.URL,
			CheckType:       createDTO.CheckType,
			IntervalSeconds: createDTO.IntervalSeconds,
			TimeoutSeconds:  createDTO.TimeoutSeconds,
			Status:          "PENDING",
			WorkingDays:     createDTO.WorkingDays,
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		// Convert back to protobuf (as handler would do)
		protoResp := handler.dtoToProto(serviceResp)

		// Verify round-trip preservation
		assert.Equal(t, createReq.Name, protoResp.Name)
		assert.Equal(t, createReq.Url, protoResp.Url)
		assert.Equal(t, createReq.CheckType, protoResp.CheckType)
		assert.Equal(t, createReq.IntervalSeconds, protoResp.IntervalSeconds)
		assert.Equal(t, createReq.TimeoutSeconds, protoResp.TimeoutSeconds)
		assert.Len(t, protoResp.WorkingDays, 3)
	})

	t.Run("check result data flow", func(t *testing.T) {
		// Simulate check result from service to protobuf
		responseTime := 150
		statusCode := 200

		serviceResp := &dto.CheckResultResponse{
			ID:             uuid.New().String(),
			MonitorID:      uuid.New().String(),
			Status:         "UP",
			ResponseTimeMs: &responseTime,
			StatusCode:     &statusCode,
			CheckedAt:      time.Now(),
			CreatedAt:      time.Now(),
		}

		protoResp := handler.checkResultDtoToProto(serviceResp)

		assert.Equal(t, "UP", protoResp.Status)
		assert.Equal(t, int32(150), protoResp.ResponseTimeMs)
		assert.Equal(t, int32(200), protoResp.StatusCode)
		assert.NotNil(t, protoResp.CheckedAt)
	})

	t.Run("incident data flow", func(t *testing.T) {
		// Simulate incident from service to protobuf
		startTime := time.Now().Add(-2 * time.Hour)
		endTime := time.Now().Add(-1 * time.Hour)
		duration := 3600

		serviceResp := &dto.IncidentResponse{
			ID:              uuid.New().String(),
			MonitorID:       uuid.New().String(),
			StartTime:       startTime,
			EndTime:         &endTime,
			DurationSeconds: &duration,
			Status:          "RESOLVED",
			CreatedAt:       time.Now(),
		}

		protoResp := handler.incidentDtoToProto(serviceResp)

		assert.Equal(t, "RESOLVED", protoResp.Status)
		assert.NotNil(t, protoResp.StartTime)
		assert.NotNil(t, protoResp.EndTime)
		assert.Equal(t, int32(3600), protoResp.DurationSeconds)
	})
}

// TestMonitorHandler_OptionalFieldHandling тестирует обработку опциональных полей.
func TestMonitorHandler_OptionalFieldHandling(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles monitor with all optional fields nil", func(t *testing.T) {
		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Minimal",
			URL:             "https://minimal.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			// All optional fields are nil
			CreatedAt: time.Now(),
			UpdatedAt: time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		// Verify optional fields are not set in protobuf
		assert.Equal(t, "", protoMonitor.WorkingHoursStart)
		assert.Equal(t, "", protoMonitor.WorkingHoursEnd)
		assert.Equal(t, int32(0), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(0), protoMonitor.DegradedFailureRateThreshold)
		assert.False(t, protoMonitor.LastCheckAt.IsValid())
	})

	t.Run("handles monitor with degraded thresholds", func(t *testing.T) {
		responseThreshold := 2000
		failureThreshold := 80

		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Degraded Monitor",
			URL:             "https://degraded.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "DEGRADED",
			DegradedResponseTimeThreshold: &responseThreshold,
			DegradedFailureRateThreshold:  &failureThreshold,
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, int32(2000), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(80), protoMonitor.DegradedFailureRateThreshold)
	})

	t.Run("handles monitor with working hours", func(t *testing.T) {
		start := "08:00"
		end := "20:00"

		dtoMonitor := &dto.MonitorResponse{
			ID:                 uuid.New().String(),
			UserID:             uuid.New().String(),
			Name:               "Business Hours",
			URL:                "https://business.com",
			CheckType:          "HTTP",
			IntervalSeconds:    300,
			TimeoutSeconds:     60,
			Status:             "UP",
			WorkingHoursStart:  &start,
			WorkingHoursEnd:    &end,
			WorkingDays:        []string{"Mon", "Tue", "Wed", "Thu", "Fri"},
			CreatedAt:          time.Now(),
			UpdatedAt:          time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, "08:00", protoMonitor.WorkingHoursStart)
		assert.Equal(t, "20:00", protoMonitor.WorkingHoursEnd)
		assert.Len(t, protoMonitor.WorkingDays, 5)
	})
}

// TestMonitorHandler_IntegrationScenarios тестирует интеграционные сценарии.
func TestMonitorHandler_IntegrationScenarios(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles pagination logic correctly", func(t *testing.T) {
		testCases := []struct {
			name     string
			limit    int32
			offset   int32
			expected int
		}{
			{"default limit", 0, 0, 100},
			{"custom limit", 50, 0, 50},
			{"custom offset", 100, 10, 100},
			{"both custom", 25, 5, 25},
		}

		for _, tc := range testCases {
			t.Run(tc.name, func(t *testing.T) {
				limit := int(tc.limit)
				if limit <= 0 {
					limit = 100
				}
				assert.Equal(t, tc.expected, limit)
			})
		}
	})

	t.Run("handles different monitor statuses", func(t *testing.T) {
		statuses := []string{"PENDING", "UP", "DOWN", "DEGRADED", "PAUSED"}

		for _, status := range statuses {
			t.Run("status_"+status, func(t *testing.T) {
				dtoMonitor := &dto.MonitorResponse{
					ID:              uuid.New().String(),
					UserID:          uuid.New().String(),
					Name:            status + " Monitor",
					URL:             "https://status-test.com",
					CheckType:       "HTTP",
					IntervalSeconds: 60,
					TimeoutSeconds:  30,
					Status:          status,
					CreatedAt:       time.Now(),
					UpdatedAt:       time.Now(),
				}

				protoMonitor := handler.dtoToProto(dtoMonitor)
				assert.Equal(t, status, protoMonitor.Status)
			})
		}
	})

	t.Run("handles incident lifecycle", func(t *testing.T) {
		// Active incident
		activeIncident := &dto.IncidentResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			StartTime: time.Now().Add(-1 * time.Hour),
			EndTime:   nil,
			Status:    "ACTIVE",
			CreatedAt: time.Now(),
		}

		protoActive := handler.incidentDtoToProto(activeIncident)
		assert.Equal(t, "ACTIVE", protoActive.Status)
		assert.Nil(t, protoActive.EndTime)

		// Resolved incident
		endTime := time.Now()
		duration := 3600

		resolvedIncident := &dto.IncidentResponse{
			ID:              uuid.New().String(),
			MonitorID:       uuid.New().String(),
			StartTime:       time.Now().Add(-2 * time.Hour),
			EndTime:         &endTime,
			DurationSeconds: &duration,
			Status:          "RESOLVED",
			CreatedAt:       time.Now(),
		}

		protoResolved := handler.incidentDtoToProto(resolvedIncident)
		assert.Equal(t, "RESOLVED", protoResolved.Status)
		assert.NotNil(t, protoResolved.EndTime)
		assert.NotNil(t, protoResolved.DurationSeconds)
	})
}
