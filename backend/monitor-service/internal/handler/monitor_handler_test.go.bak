// TestMonitorHandler_ErrorConversion тестирует конвертацию ошибок.
func TestMonitorHandler_ErrorConversion(t *testing.T) {
	handler := &MonitorHandler{}

	testCases := []struct {
		name        string
		err         error
		expectedCode codes.Code
	}{
		{
			name:        "ErrMonitorNotFound",
			err:         interfaces.ErrMonitorNotFound,
			expectedCode: codes.NotFound,
		},
		{
			name:        "ErrMonitorAlreadyExists",
			err:         interfaces.ErrMonitorAlreadyExists,
			expectedCode: codes.AlreadyExists,
		},
		{
			name:        "unknown error",
			err:         stderrors.New("unknown"),
			expectedCode: codes.Internal,
		},
	}

	for _, tc := range testCases {
		t.Run(tc.name, func(t *testing.T) {
			err := handler.handleError(tc.err)
			assert.Error(t, err)
			assert.Equal(t, tc.expectedCode, status.Code(err))
		})
	}
}

// TestMonitorHandler_PointerHandling тестирует работу с указателями.
func TestMonitorHandler_PointerHandling(t *testing.T) {
	t.Run("intPtr nil for zero", func(t *testing.T) {
		result := intPtr(0)
		assert.Nil(t, result)
	})

	t.Run("intPtr non-nil for non-zero", func(t *testing.T) {
		result := intPtr(100)
		assert.NotNil(t, result)
		assert.Equal(t, 100, *result)
	})

	t.Run("stringPtr nil for empty", func(t *testing.T) {
		result := stringPtr("")
		assert.Nil(t, result)
	})

	t.Run("stringPtr non-nil for non-empty", func(t *testing.T) {
		result := stringPtr("test")
		assert.NotNil(t, result)
		assert.Equal(t, "test", *result)
	})

	t.Run("int32Ptr nil for zero", func(t *testing.T) {
		result := int32Ptr(0)
		assert.Nil(t, result)
	})

	t.Run("int32Ptr non-nil for non-zero", func(t *testing.T) {
		result := int32Ptr(50)
		assert.NotNil(t, result)
		assert.Equal(t, int32(50), *result)
	})
}

// TestMonitorHandler_DtoToProto тестирует конвертацию DTO в protobuf.
func TestMonitorHandler_DtoToProto(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts basic monitor", func(t *testing.T) {
		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Test Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, "Test Monitor", protoMonitor.Name)
		assert.Equal(t, "https://example.com", protoMonitor.Url)
		assert.Equal(t, "UP", protoMonitor.Status)
		assert.Equal(t, int32(60), protoMonitor.IntervalSeconds)
		assert.Equal(t, int32(30), protoMonitor.TimeoutSeconds)
	})

	t.Run("converts monitor with optional fields", func(t *testing.T) {
		threshold := 1000
		failureRate := 50
		lastCheck := time.Now()

		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Test Monitor",
			URL:             "https://example.com",
			Status:          "DEGRADED",
			LastCheckAt:     &lastCheck,
			DegradedResponseTimeThreshold: &threshold,
			DegradedFailureRateThreshold:  &failureRate,
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		// In protobuf, these are int32, not pointers
		assert.Equal(t, int32(1000), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(50), protoMonitor.DegradedFailureRateThreshold)
	})
}

// TestMonitorHandler_CheckResultDtoToProto тестирует конвертацию CheckResult.
func TestMonitorHandler_CheckResultDtoToProto(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts check result with all fields", func(t *testing.T) {
		responseTimeMs := 250
		statusCode := 200

		dtoResult := &dto.CheckResultResponse{
			ID:             uuid.New().String(),
			MonitorID:      uuid.New().String(),
			Status:         "UP",
			ResponseTimeMs: &responseTimeMs,
			StatusCode:     &statusCode,
			CheckedAt:      time.Now(),
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)

		assert.Equal(t, "UP", protoResult.Status)
		// In protobuf, these are int32, not pointers (when set)
		assert.NotNil(t, protoResult.ResponseTimeMs)
		assert.NotNil(t, protoResult.StatusCode)
		assert.Equal(t, int32(250), protoResult.ResponseTimeMs)
		assert.Equal(t, int32(200), protoResult.StatusCode)
	})

	t.Run("converts check result with error", func(t *testing.T) {
		errorMsg := "connection timeout"

		dtoResult := &dto.CheckResultResponse{
			ID:           uuid.New().String(),
			MonitorID:    uuid.New().String(),
			Status:       "DOWN",
			ErrorMessage: &errorMsg,
			CheckedAt:    time.Now(),
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)

		assert.Equal(t, "DOWN", protoResult.Status)
		// In protobuf, ErrorMessage is a string, not pointer
		assert.Equal(t, "connection timeout", protoResult.ErrorMessage)
	})
}

// TestMonitorHandler_IncidentDtoToProto тестирует конвертацию Incident.
func TestMonitorHandler_IncidentDtoToProto(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts active incident", func(t *testing.T) {
		startTime := time.Now().Add(-1 * time.Hour)

		dtoIncident := &dto.IncidentResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			StartTime: startTime,
			EndTime:   nil,
			Status:    "ACTIVE",
		}

		protoIncident := handler.incidentDtoToProto(dtoIncident)

		assert.Equal(t, "ACTIVE", protoIncident.Status)
		assert.NotNil(t, protoIncident.StartTime)
		assert.Nil(t, protoIncident.EndTime)
	})

	t.Run("converts resolved incident", func(t *testing.T) {
		startTime := time.Now().Add(-2 * time.Hour)
		endTime := time.Now().Add(-1 * time.Hour)
		duration := 3600

		dtoIncident := &dto.IncidentResponse{
			ID:              uuid.New().String(),
			MonitorID:       uuid.New().String(),
			StartTime:       startTime,
			EndTime:         &endTime,
			DurationSeconds: &duration,
			Status:          "RESOLVED",
		}

		protoIncident := handler.incidentDtoToProto(dtoIncident)

		assert.Equal(t, "RESOLVED", protoIncident.Status)
		assert.NotNil(t, protoIncident.StartTime)
		assert.NotNil(t, protoIncident.EndTime)
		// In protobuf, DurationSeconds is int32, not pointer (when set)
		assert.NotNil(t, protoIncident.DurationSeconds)
		assert.Equal(t, int32(3600), protoIncident.DurationSeconds)
	})
}

// TestMonitorHandler_DtoToProto_Comprehensive тестирует полную конвертацию DTO в protobuf.
func TestMonitorHandler_DtoToProto_Comprehensive(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts monitor with working hours", func(t *testing.T) {
		start := "09:00"
		end := "18:00"

		dtoMonitor := &dto.MonitorResponse{
			ID:                 uuid.New().String(),
			UserID:             uuid.New().String(),
			Name:               "Business Hours Monitor",
			URL:                "https://example.com",
			CheckType:          "HTTP",
			IntervalSeconds:    300,
			TimeoutSeconds:     30,
			Status:             "UP",
			WorkingHoursStart:  &start,
			WorkingHoursEnd:    &end,
			WorkingDays:        []string{"Mon", "Tue", "Wed", "Thu", "Fri"},
			CreatedAt:          time.Now(),
			UpdatedAt:          time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, "09:00", protoMonitor.WorkingHoursStart)
		assert.Equal(t, "18:00", protoMonitor.WorkingHoursEnd)
		assert.Len(t, protoMonitor.WorkingDays, 5)
		assert.Equal(t, "Mon", protoMonitor.WorkingDays[0])
	})

	t.Run("converts monitor with all optional fields", func(t *testing.T) {
		threshold := 2000
		failureRate := 75
		lastCheck := time.Now()

		dtoMonitor := &dto.MonitorResponse{
			ID:                              uuid.New().String(),
			UserID:                          uuid.New().String(),
			Name:                            "Complete Monitor",
			URL:                             "https://example.com",
			CheckType:                       "HTTPS",
			IntervalSeconds:                 120,
			TimeoutSeconds:                  60,
			Status:                          "DEGRADED",
			LastCheckAt:                     &lastCheck,
			DegradedResponseTimeThreshold:   &threshold,
			DegradedFailureRateThreshold:    &failureRate,
			CreatedAt:                       time.Now(),
			UpdatedAt:                       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, int32(2000), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(75), protoMonitor.DegradedFailureRateThreshold)
		assert.NotNil(t, protoMonitor.LastCheckAt)
	})

	t.Run("converts monitor without optional fields", func(t *testing.T) {
		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "Minimal Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "PENDING",
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		assert.Equal(t, int32(0), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(0), protoMonitor.DegradedFailureRateThreshold)
		assert.False(t, protoMonitor.LastCheckAt.IsValid())
	})

	t.Run("converts monitor with zero timestamp fields", func(t *testing.T) {
		threshold := 0
		failureRate := 0

		dtoMonitor := &dto.MonitorResponse{
			ID:                              uuid.New().String(),
			UserID:                          uuid.New().String(),
			Name:                            "Zero Threshold Monitor",
			URL:                             "https://example.com",
			CheckType:                       "HTTP",
			IntervalSeconds:                 60,
			TimeoutSeconds:                  30,
			Status:                          "UP",
			DegradedResponseTimeThreshold:   &threshold,
			DegradedFailureRateThreshold:    &failureRate,
			CreatedAt:                       time.Now(),
			UpdatedAt:                       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)

		// Zero values should not be set in protobuf
		assert.Equal(t, int32(0), protoMonitor.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(0), protoMonitor.DegradedFailureRateThreshold)
	})
}

// TestMonitorHandler_CheckResultDtoToProto_Comprehensive тестирует полную конвертацию CheckResult.
func TestMonitorHandler_CheckResultDtoToProto_Comprehensive(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts check result without optional fields", func(t *testing.T) {
		dtoResult := &dto.CheckResultResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			Status:    "PENDING",
			CheckedAt: time.Now(),
			CreatedAt: time.Now(),
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)

		assert.Equal(t, "PENDING", protoResult.Status)
		assert.Equal(t, int32(0), protoResult.ResponseTimeMs)
		assert.Equal(t, int32(0), protoResult.StatusCode)
		assert.Equal(t, "", protoResult.ErrorMessage)
	})

	t.Run("converts check result with minimal fields", func(t *testing.T) {
		responseTimeMs := 0
		statusCode := 0

		dtoResult := &dto.CheckResultResponse{
			ID:             uuid.New().String(),
			MonitorID:      uuid.New().String(),
			Status:         "UP",
			ResponseTimeMs: &responseTimeMs,
			StatusCode:     &statusCode,
			CheckedAt:      time.Now(),
			CreatedAt:      time.Now(),
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)

		assert.Equal(t, "UP", protoResult.Status)
		// Even with zero pointers, these should be set in proto
		assert.Equal(t, int32(0), protoResult.ResponseTimeMs)
		assert.Equal(t, int32(0), protoResult.StatusCode)
	})

	t.Run("converts check result with all fields", func(t *testing.T) {
		responseTimeMs := 150
		statusCode := 200
		errorMsg := ""

		dtoResult := &dto.CheckResultResponse{
			ID:             uuid.New().String(),
			MonitorID:      uuid.New().String(),
			Status:         "UP",
			ResponseTimeMs: &responseTimeMs,
			StatusCode:     &statusCode,
			ErrorMessage:   &errorMsg,
			CheckedAt:      time.Now(),
			CreatedAt:      time.Now(),
		}

		protoResult := handler.checkResultDtoToProto(dtoResult)

		assert.Equal(t, "UP", protoResult.Status)
		assert.Equal(t, int32(150), protoResult.ResponseTimeMs)
		assert.Equal(t, int32(200), protoResult.StatusCode)
		assert.Equal(t, "", protoResult.ErrorMessage)
	})
}

// TestMonitorHandler_IncidentDtoToProto_Comprehensive тестирует полную конвертацию Incident.
func TestMonitorHandler_IncidentDtoToProto_Comprehensive(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("converts incident without optional fields", func(t *testing.T) {
		dtoIncident := &dto.IncidentResponse{
			ID:        uuid.New().String(),
			MonitorID: uuid.New().String(),
			StartTime: time.Now().Add(-24 * time.Hour),
			Status:    "ACTIVE",
			CreatedAt: time.Now(),
		}

		protoIncident := handler.incidentDtoToProto(dtoIncident)

		assert.Equal(t, "ACTIVE", protoIncident.Status)
		assert.Nil(t, protoIncident.EndTime)
		assert.Equal(t, int32(0), protoIncident.DurationSeconds)
	})

	t.Run("converts incident with zero duration", func(t *testing.T) {
		endTime := time.Now()
		duration := 0

		dtoIncident := &dto.IncidentResponse{
			ID:              uuid.New().String(),
			MonitorID:       uuid.New().String(),
			StartTime:       time.Now().Add(-1 * time.Hour),
			EndTime:         &endTime,
			DurationSeconds: &duration,
			Status:          "RESOLVED",
			CreatedAt:       time.Now(),
		}

		protoIncident := handler.incidentDtoToProto(dtoIncident)

		assert.Equal(t, "RESOLVED", protoIncident.Status)
		assert.NotNil(t, protoIncident.EndTime)
		assert.Equal(t, int32(0), protoIncident.DurationSeconds)
	})

	t.Run("converts incident with long duration", func(t *testing.T) {
		startTime := time.Now().Add(-48 * time.Hour)
		endTime := time.Now()
		duration := 172800 // 48 hours in seconds

		dtoIncident := &dto.IncidentResponse{
			ID:              uuid.New().String(),
			MonitorID:       uuid.New().String(),
			StartTime:       startTime,
			EndTime:         &endTime,
			DurationSeconds: &duration,
			Status:          "RESOLVED",
			CreatedAt:       time.Now(),
		}

		protoIncident := handler.incidentDtoToProto(dtoIncident)

		assert.Equal(t, "RESOLVED", protoIncident.Status)
		assert.NotNil(t, protoIncident.EndTime)
		assert.Equal(t, int32(172800), protoIncident.DurationSeconds)
	})
}

// TestMonitorHandler_ErrorHandling_Comprehensive тестирует обработку всех типов ошибок.
func TestMonitorHandler_ErrorHandling_Comprehensive(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles nil error", func(t *testing.T) {
		err := handler.handleError(nil)
		assert.Error(t, err)
		assert.Equal(t, codes.Internal, status.Code(err))
	})

	t.Run("handles wrapped errors", func(t *testing.T) {
		wrappedErr := errors.Wrap(interfaces.ErrMonitorNotFound, "monitor not found in repository")
		err := handler.handleError(wrappedErr)
		assert.Error(t, err)
		assert.Equal(t, codes.NotFound, status.Code(err))
	})

	t.Run("handles multiple wrapped errors", func(t *testing.T) {
		wrappedErr := errors.Wrap(errors.Wrap(interfaces.ErrMonitorAlreadyExists, "duplicate key"), "database constraint")
		err := handler.handleError(wrappedErr)
		assert.Error(t, err)
		assert.Equal(t, codes.AlreadyExists, status.Code(err))
	})

	t.Run("preserves error message for unknown errors", func(t *testing.T) {
		unknownErr := stderrors.New("database connection failed")
		err := handler.handleError(unknownErr)
		assert.Error(t, err)
		assert.Equal(t, codes.Internal, status.Code(err))
	})
}

// TestMonitorHandler_ValidationScenarios тестирует сценарии валидации.
func TestMonitorHandler_ValidationScenarios(t *testing.T) {
	t.Run("accepts valid CreateMonitorRequest structure", func(t *testing.T) {
		req := &monitov1.CreateMonitorRequest{
			Name:            "Valid Monitor",
			Url:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
		}

		// Verify the request structure is valid
		assert.Equal(t, "Valid Monitor", req.Name)
		assert.Equal(t, "https://example.com", req.Url)
		assert.Equal(t, int32(60), req.IntervalSeconds)
		assert.Equal(t, int32(30), req.TimeoutSeconds)
	})

	t.Run("accepts valid UpdateMonitorRequest structure", func(t *testing.T) {
		req := &monitov1.UpdateMonitorRequest{
			Id:   uuid.New().String(),
			Name: "Updated Name",
		}

		// Verify the request structure is valid
		assert.NotEmpty(t, req.Id)
		assert.Equal(t, "Updated Name", req.Name)
	})

	t.Run("handles request with all optional fields", func(t *testing.T) {
		req := &monitov1.CreateMonitorRequest{
			Name:                                "Complete Monitor",
			Url:                                 "https://example.com",
			CheckType:                           "HTTP",
			IntervalSeconds:                     300,
			TimeoutSeconds:                      60,
			WorkingHoursStart:                   "09:00",
			WorkingHoursEnd:                     "18:00",
			WorkingDays:                         []string{"Mon", "Tue", "Wed", "Thu", "Fri"},
			DegradedResponseTimeThreshold:       1000,
			DegradedFailureRateThreshold:        50,
		}

		// Verify all fields are set correctly
		assert.Equal(t, "Complete Monitor", req.Name)
		assert.Equal(t, int32(1000), req.DegradedResponseTimeThreshold)
		assert.Equal(t, int32(50), req.DegradedFailureRateThreshold)
		assert.Len(t, req.WorkingDays, 5)
	})
}

// TestMonitorHandler_EdgeCases тестирует граничные случаи.
func TestMonitorHandler_EdgeCases(t *testing.T) {
	handler := &MonitorHandler{}

	t.Run("handles monitor with extreme interval values", func(t *testing.T) {
		minInterval := int32(30)
		maxInterval := int32(3600)

		assert.NotNil(t, intPtr(minInterval))
		assert.NotNil(t, intPtr(maxInterval))
		assert.Nil(t, intPtr(0))
	})

	t.Run("handles monitor with extreme timeout values", func(t *testing.T) {
		minTimeout := int32(1)
		maxTimeout := int32(300)

		assert.NotNil(t, intPtr(minTimeout))
		assert.NotNil(t, intPtr(maxTimeout))
		assert.Nil(t, intPtr(0))
	})

	t.Run("handles empty working days array", func(t *testing.T) {
		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "No Working Days",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			WorkingDays:     []string{},
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)
		assert.NotNil(t, protoMonitor.WorkingDays)
		assert.Len(t, protoMonitor.WorkingDays, 0)
	})

	t.Run("handles all working days", func(t *testing.T) {
		allDays := []string{"Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"}

		dtoMonitor := &dto.MonitorResponse{
			ID:              uuid.New().String(),
			UserID:          uuid.New().String(),
			Name:            "All Days Monitor",
			URL:             "https://example.com",
			CheckType:       "HTTP",
			IntervalSeconds: 60,
			TimeoutSeconds:  30,
			Status:          "UP",
			WorkingDays:     allDays,
			CreatedAt:       time.Now(),
			UpdatedAt:       time.Now(),
		}

		protoMonitor := handler.dtoToProto(dtoMonitor)
		assert.Len(t, protoMonitor.WorkingDays, 7)
		assert.Equal(t, "Sun", protoMonitor.WorkingDays[0])
		assert.Equal(t, "Sat", protoMonitor.WorkingDays[6])
	})
}

// TestMonitorHandler_StatusConversion тестирует конвертацию всех статусов.
func TestMonitorHandler_StatusConversion(t *testing.T) {
	handler := &MonitorHandler{}

