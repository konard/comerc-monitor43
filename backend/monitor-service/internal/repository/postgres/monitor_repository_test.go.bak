// pqArrayString - вспомогательная функция для создания PostgreSQL array byte representation
func pqArrayString(days []string) []byte {
	if len(days) == 0 {
		return nil
	}
	result := "{"
	for i, d := range days {
		if i > 0 {
			result += ","
		}
		result += d
	}
	result += "}"
	return []byte(result)
}

// TestMonitorRepository_GetByID_WithWorkingHours тестирует получение монитора с рабочими часами.
func TestMonitorRepository_GetByID_WithWorkingHours(t *testing.T) {
	db, mock, err := sqlmock.New()
	require.NoError(t, err)
	defer db.Close()

	repo := NewMonitorRepository(db)

	monitorID := uuid.New()
	userID := uuid.New()
	now := time.Now()
	startTime := now.Truncate(time.Hour).Add(9 * time.Hour)
	endTime := now.Truncate(time.Hour).Add(18 * time.Hour)

	rows := sqlmock.NewRows([]string{
		"id", "user_id", "name", "url", "check_type", "interval_seconds", "timeout_seconds",
		"status", "working_hours_start", "working_hours_end", "working_days",
		"degraded_response_time_threshold", "degraded_failure_rate_threshold",
		"last_check_at", "created_at", "updated_at",
	}).AddRow(
		monitorID, userID, "Business Hours Monitor", "https://example.com", "HTTP", 60, 30,
		"UP", startTime, endTime, pqArrayString([]string{"Monday", "Tuesday", "Wednesday", "Thursday", "Friday"}),
		int64(1000), int64(50), nil, now, now,
	)

	mock.ExpectQuery(regexp.QuoteMeta(`
		SELECT id, user_id, name, url, check_type, interval_seconds, timeout_seconds,
			status, working_hours_start, working_hours_end, working_days,
			degraded_response_time_threshold, degraded_failure_rate_threshold,
			last_check_at, created_at, updated_at
		FROM monitors
		WHERE id = $1
	`)).WithArgs(monitorID).WillReturnRows(rows)

	monitor, err := repo.GetByID(context.Background(), monitorID)
	assert.NoError(t, err)
	assert.NotNil(t, monitor)
	assert.NotNil(t, monitor.WorkingHoursStart)
	assert.NotNil(t, monitor.WorkingHoursEnd)
	assert.NotNil(t, monitor.DegradedResponseTimeThreshold)
	assert.NotNil(t, monitor.DegradedFailureRateThreshold)
	assert.Equal(t, 1000, *monitor.DegradedResponseTimeThreshold)
	assert.Equal(t, 50, *monitor.DegradedFailureRateThreshold)
	assert.NoError(t, mock.ExpectationsWereMet())
}

// TestMonitorRepository_GetByID_WithLastCheck тестирует получение монитора с последней проверкой.
func TestMonitorRepository_GetByID_WithLastCheck(t *testing.T) {
	db, mock, err := sqlmock.New()
	require.NoError(t, err)
	defer db.Close()

	repo := NewMonitorRepository(db)

	monitorID := uuid.New()
	userID := uuid.New()
	now := time.Now()
	lastCheck := now.Add(-5 * time.Minute)

	rows := sqlmock.NewRows([]string{
		"id", "user_id", "name", "url", "check_type", "interval_seconds", "timeout_seconds",
		"status", "working_hours_start", "working_hours_end", "working_days",
		"degraded_response_time_threshold", "degraded_failure_rate_threshold",
		"last_check_at", "created_at", "updated_at",
	}).AddRow(
		monitorID, userID, "Recently Checked", "https://example.com", "HTTP", 60, 30,
		"UP", nil, nil, nil,
		nil, nil, lastCheck, now, now,
	)

	mock.ExpectQuery(regexp.QuoteMeta(`
		SELECT id, user_id, name, url, check_type, interval_seconds, timeout_seconds,
			status, working_hours_start, working_hours_end, working_days,
			degraded_response_time_threshold, degraded_failure_rate_threshold,
			last_check_at, created_at, updated_at
		FROM monitors
		WHERE id = $1
	`)).WithArgs(monitorID).WillReturnRows(rows)

	monitor, err := repo.GetByID(context.Background(), monitorID)
	assert.NoError(t, err)
	assert.NotNil(t, monitor)
	assert.NotNil(t, monitor.LastCheckAt)
	assert.NoError(t, mock.ExpectationsWereMet())
}

