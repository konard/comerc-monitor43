// TestMonitorRepository_ListByUserID_WithNullWorkingDays тестирует получение мониторов с null working_days.
func TestMonitorRepository_ListByUserID_WithNullWorkingDays(t *testing.T) {
	db, mock, err := sqlmock.New()
	require.NoError(t, err)
	defer db.Close()

	repo := NewMonitorRepository(db)

	userID := uuid.New()
	now := time.Now()

	rows := sqlmock.NewRows([]string{
		"id", "user_id", "name", "url", "check_type", "interval_seconds", "timeout_seconds",
		"status", "working_hours_start", "working_hours_end", "working_days",
		"degraded_response_time_threshold", "degraded_failure_rate_threshold",
		"last_check_at", "created_at", "updated_at",
	}).AddRow(
		uuid.New(), userID, "Monitor 1", "https://example.com", "HTTP", 60, 30,
		"UP", nil, nil, nil,
		nil, nil, nil, now, now,
	)

	mock.ExpectQuery(regexp.QuoteMeta(`
		SELECT id, user_id, name, url, check_type, interval_seconds, timeout_seconds,
			status, working_hours_start, working_hours_end, working_days,
			degraded_response_time_threshold, degraded_failure_rate_threshold,
			last_check_at, created_at, updated_at
		FROM monitors
		WHERE user_id = $1
		ORDER BY created_at DESC
		LIMIT $2 OFFSET $3
	`)).WithArgs(userID, 10, 0).WillReturnRows(rows)

	monitors, err := repo.ListByUserID(context.Background(), userID, 10, 0)
	assert.NoError(t, err)
	assert.Len(t, monitors, 1)
	assert.NoError(t, mock.ExpectationsWereMet())
}

// TestMonitorRepository_ListByUserID_MultipleMonitors тестирует получение списка мониторов с разными статусами.
func TestMonitorRepository_ListByUserID_MultipleMonitors(t *testing.T) {
	db, mock, err := sqlmock.New()
	require.NoError(t, err)
	defer db.Close()

	repo := NewMonitorRepository(db)

	userID := uuid.New()
	now := time.Now()

	rows := sqlmock.NewRows([]string{
		"id", "user_id", "name", "url", "check_type", "interval_seconds", "timeout_seconds",
		"status", "working_hours_start", "working_hours_end", "working_days",
		"degraded_response_time_threshold", "degraded_failure_rate_threshold",
		"last_check_at", "created_at", "updated_at",
	}).
		AddRow(
			uuid.New(), userID, "Monitor 1", "https://example1.com", "HTTP", 60, 30,
			"UP", nil, nil, pqArrayString([]string{"Monday"}),
			nil, nil, nil, now, now,
		).
		AddRow(
			uuid.New(), userID, "Monitor 2", "https://example2.com", "HTTP", 120, 30,
			"DOWN", nil, nil, pqArrayString([]string{"Tuesday"}),
			nil, nil, nil, now.Add(-time.Hour), now.Add(-time.Hour),
		).
		AddRow(
			uuid.New(), userID, "Monitor 3", "https://example3.com", "HTTPS", 300, 60,
			"DEGRADED", nil, nil, pqArrayString([]string{"Wednesday"}),
			int64(2000), int64(70), nil, now.Add(-2*time.Hour), now.Add(-2*time.Hour),
		)

	mock.ExpectQuery(regexp.QuoteMeta(`
		SELECT id, user_id, name, url, check_type, interval_seconds, timeout_seconds,
			status, working_hours_start, working_hours_end, working_days,
			degraded_response_time_threshold, degraded_failure_rate_threshold,
			last_check_at, created_at, updated_at
		FROM monitors
		WHERE user_id = $1
		ORDER BY created_at DESC
		LIMIT $2 OFFSET $3
	`)).WithArgs(userID, 10, 0).WillReturnRows(rows)

	monitors, err := repo.ListByUserID(context.Background(), userID, 10, 0)
	assert.NoError(t, err)
	assert.Len(t, monitors, 3)
	assert.Equal(t, domain.StatusUp, monitors[0].Status)
	assert.Equal(t, domain.StatusDown, monitors[1].Status)
	assert.Equal(t, domain.StatusDegraded, monitors[2].Status)
	assert.NotNil(t, monitors[2].DegradedResponseTimeThreshold)
	assert.NotNil(t, monitors[2].DegradedFailureRateThreshold)
	assert.NoError(t, mock.ExpectationsWereMet())
}
