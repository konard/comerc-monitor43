# Server Configuration
SERVER_PORT=8081
SERVER_GRPC_PORT=5002

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=<change-me>
DB_SSL_MODE=disable

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_ENABLED=true

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PORT=9091

# Auth Service Integration
AUTH_SERVICE_GRPC_ADDRESS=localhost:5001

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h

# Check Configuration
DEFAULT_CHECK_INTERVAL=5m
DEFAULT_CHECK_TIMEOUT=30s
MAX_CONCURRENT_CHECKS=100
CHECK_QUEUE_SIZE=1000
MAX_RECENT_RESULTS_FOR_STATS=100

# Degraded Threshold Defaults
DEFAULT_DEGRADED_RESPONSE_TIME=1000
DEFAULT_DEGRADED_FAILURE_RATE=50

# Incident Detection
INCIDENT_DETECTION_ENABLED=true
INCIDENT_RESOLVE_THRESHOLD=1

# Data Retention
CHECK_RESULT_RETENTION_DAYS=90
INCIDENT_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=365

# Maintenance Window Configuration
MAINTENANCE_MIN_DURATION_MINUTES=1
MAINTENANCE_MAX_DURATION_HOURS=24
MAINTENANCE_MAX_WINDOWS_FREE=5
MAINTENANCE_MAX_WINDOWS_PRO=20
MAINTENANCE_MAX_WINDOWS_ENTERPRISE=100
MAINTENANCE_MAX_MONITORS_PER_WINDOW=50

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=monitor-service
OTEL_LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
