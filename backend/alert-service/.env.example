# Server
SERVER_PORT=50051
SERVER_HOST=0.0.0.0
METRICS_PORT=9090
GRPC_REFLECTION=false

# Alert throttling
ALERT_COOLDOWN_PERIOD=15m
ALERT_RATE_LIMIT_PERIOD=5m
ALERT_STORM_WINDOW=5m
ALERT_STORM_THRESHOLD=5
ALERT_STORM_DURATION=10m

# Flapping detection
FLAPPING_WINDOW=10m
FLAPPING_THRESHOLD=5
FLAPPING_EXIT_PERIOD=15m

# Escalation
ESCALATION_TIMEOUT=30m

# Retention
ALERT_RETENTION_DAYS=90

# Channel limits per user tier
CHANNEL_LIMIT_FREE=10
CHANNEL_LIMIT_STARTER=25
CHANNEL_LIMIT_PROFESSIONAL=100
CHANNEL_LIMIT_BUSINESS=500

# Delivery queue
DELIVERY_QUEUE_LIMIT=1000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=milan
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFETIME=5m

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=alert-service
OTEL_LOG_LEVEL=info

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production

# Telegram notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@monitor.example.com

# Webhook
WEBHOOK_TIMEOUT=30s

# Delivery retry settings
DELIVERY_MAX_RETRIES=3
DELIVERY_RETRY_INTERVAL=5m
