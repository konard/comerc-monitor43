# =============================================================================
# Server Configuration
# =============================================================================
SERVER_PORT=8082
SERVER_GRPC_PORT=5003

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# =============================================================================
# Payment Providers
# =============================================================================
# Yookassa
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key
YOOKASSA_WEBHOOK_SECRET=your-webhook-secret
YOOKASSA_RETURN_URL=https://yourapp.com/billing/return
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3

# Stripe
STRIPE_API_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-key
STRIPE_BASE_URL=https://api.stripe.com

# =============================================================================
# Observability
# =============================================================================
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=billing-service
OTEL_ENVIRONMENT=development
OTEL_SAMPLING_RATE=1.0

METRICS_ENABLED=true
METRICS_PORT=9092
METRICS_PATH=/metrics

# =============================================================================
# Subscription Configuration
# =============================================================================
DEFAULT_TRIAL_PERIOD_DAYS=7
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
AUTO_RENEW_ENABLED=true

# =============================================================================
# Auth Service Integration
# =============================================================================
AUTH_SERVICE_GRPC_ADDRESS=localhost:5001

# =============================================================================
# RabbitMQ Configuration
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=billing.events

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_WEBHOOK_VERIFICATION=true
FEATURE_AUTO_RENEWAL=true
FEATURE_PAYMENT_HISTORY=true
