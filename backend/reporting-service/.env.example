# Server
SERVER_PORT=8084
SERVER_GRPC_PORT=5007
SERVER_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=monitor
DB_USER=monitor
DB_PASSWORD=monitor
DB_SSL_MODE=disable

# Monitor Service
MONITOR_SERVICE_GRPC_ADDRESS=localhost:5002

# Auth
JWT_SECRET_KEY=secret-key

# Reporting
REPORTING_RETENTION_DAYS=90
REPORTING_EXPORT_TIMEOUT=60s
REPORTING_MAX_EXPORT_ROWS=50000

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=reporting-service
OTEL_ENVIRONMENT=development
OTEL_SAMPLING_RATE=1.0

METRICS_ENABLED=true
METRICS_PORT=9097
METRICS_PATH=/metrics

LOG_LEVEL=info
