# Server
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=60s

# Auth service
AUTH_SERVICE_ADDR=localhost:5001
AUTH_SERVICE_TIMEOUT=5s

# Downstream services
SERVICE_TIMEOUT=30s
MONITOR_SERVICE_ADDR=http://localhost:5002
ALERT_SERVICE_ADDR=http://localhost:5003
BILLING_SERVICE_ADDR=http://localhost:5004
SCHEDULER_SERVICE_ADDR=http://localhost:5005

# Observability
LOG_LEVEL=info
ENABLE_TRACING=false
METRICS_ENABLED=false
METRICS_PORT=9090
