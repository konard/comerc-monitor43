# Server
SERVER_PORT=8084
SERVER_GRPC_PORT=5014

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=integration_service
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# RabbitMQ (for consuming alert events)
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=monitor

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
METRICS_PORT=9094
LOG_LEVEL=info

# External Services
AUTH_SERVICE_GRPC_ADDRESS=localhost:5001
BILLING_SERVICE_GRPC_ADDRESS=localhost:5003
MONITOR_SERVICE_GRPC_ADDRESS=localhost:5000

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-in-production
