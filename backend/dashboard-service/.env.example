# Server
SERVER_PORT=9095
HTTP_PORT=8095
SERVER_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dashboard
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MAX_LIFETIME=5m

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=dashboard-service
OTEL_LOG_LEVEL=info

# Authentication
JWT_SECRET=your-secret-key-here

# WebSocket
WS_MAX_CONNECTIONS=1000
WS_WRITE_TIMEOUT=10s
WS_PONG_TIMEOUT=60s
WS_PING_INTERVAL=54s
WS_MAX_MESSAGE_SIZE=1024

# Throttling
THROTTLE_BATCH_SIZE=50
THROTTLE_FLUSH_INTERVAL=50ms

# Export
EXPORT_DIR=/tmp/dashboard-exports
