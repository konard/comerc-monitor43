func TestScheduleCheck_success(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	workerRepo := &mockWorkerRepo{}
	auditRepo := &mockAuditRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, auditRepo, nil, 2*time.Minute, logger)

	checkRepo.On("HasPendingCheck", mock.Anything, mock.Anything).Return(false, nil)
	workerRepo.On("ListIdleByZone", mock.Anything, "").Return([]*model.Worker{}, nil)
	checkRepo.On("Create", mock.Anything, mock.Anything).Return(nil)

	result, err := svc.ScheduleCheck(ctx, uuid.New(), model.PriorityNormal, time.Now())

	require.NoError(t, err)
	assert.Equal(t, model.CheckStatusPending, result.Status)
}

func TestScheduleCheck_already_pending(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	workerRepo := &mockWorkerRepo{}
	auditRepo := &mockAuditRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, auditRepo, nil, 2*time.Minute, logger)

	checkRepo.On("HasPendingCheck", mock.Anything, mock.Anything).Return(true, nil)

	_, err := svc.ScheduleCheck(ctx, uuid.New(), model.PriorityNormal, time.Now())

	assert.ErrorIs(t, err, model.ErrCheckAlreadyPending)
	checkRepo.AssertNotCalled(t, "Create")
}

func TestScheduleCheck_with_worker(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	worker := model.NewWorker("worker-01", "msk")
	workerRepo := &mockWorkerRepo{}
	auditRepo := &mockAuditRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, auditRepo, nil, 2*time.Minute, logger)

	checkRepo.On("HasPendingCheck", mock.Anything, mock.Anything).Return(false, nil)
	workerRepo.On("ListIdleByZone", mock.Anything, "").Return([]*model.Worker{worker}, nil)
	checkRepo.On("Create", mock.Anything, mock.Anything).Return(nil)

	result, err := svc.ScheduleCheck(ctx, uuid.New(), model.PriorityNormal, time.Now())

	require.NoError(t, err)
	assert.Equal(t, worker.ID, result.WorkerID)
	assert.Equal(t, model.CheckStatusInProgress, result.Status)
}

func TestGetScheduledChecks_invalid_time_range(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, nil, nil, nil, 2*time.Minute, logger)

	from := time.Now()
	to := from.Add(-1 * time.Hour)

	_, _, err := svc.GetScheduledChecks(ctx, from, to, "", 1, 20)

	assert.ErrorIs(t, err, model.ErrInvalidTimeRange)
}

