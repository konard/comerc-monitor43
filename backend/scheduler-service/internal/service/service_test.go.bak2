func TestSelectWorker_idle_available(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	w := model.NewWorker("worker-01", "msk")
	workerRepo.On("ListIdleByZone", mock.Anything, "moscow").Return([]*model.Worker{w}, nil)

	result, err := svc.SelectWorker(context.Background(), "moscow")

	require.NoError(t, err)
	assert.Equal(t, "worker-01", result.Name)
}

func TestSelectWorker_fallback_to_any_zone(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	w := model.NewWorker("worker-spb-01", "spb")
	workerRepo.On("ListIdleByZone", mock.Anything, "moscow").Return([]*model.Worker{}, nil)
	workerRepo.On("ListIdleByZone", mock.Anything, "").Return([]*model.Worker{w}, nil)

	result, err := svc.SelectWorker(context.Background(), "moscow")

	require.NoError(t, err)
	assert.Equal(t, "worker-spb-01", result.Name)
}

func TestSelectWorker_no_workers(t *testing.T) {
