}

func TestHeartbeat(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	worker := model.NewWorker("worker-01", "msk")
	workerRepo.On("GetByID", mock.Anything, mock.Anything).Return(worker, nil)
	workerRepo.On("Update", mock.Anything, mock.Anything).Return(nil)

	err := svc.Heartbeat(context.Background(), worker.ID, model.WorkerStatusBusy, 100, 5, 245.5)

	require.NoError(t, err)
	workerRepo.AssertCalled(t, "Update", mock.Anything, mock.Anything)
}

func TestHeartbeat_not_found(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	workerRepo.On("GetByID", mock.Anything, mock.Anything).Return(nil, errors.New("not found"))

	err := svc.Heartbeat(context.Background(), uuid.New(), model.WorkerStatusIdle, 0, 0, 0)

	assert.ErrorIs(t, err, model.ErrWorkerNotFound)
}

func TestUnregisterWorker(t *testing.T) {
	t.Parallel()

	svc, workerRepo, checkRepo, auditRepo := newTestWorkerService(t)
	worker := model.NewWorker("worker-01", "msk")
	workerRepo.On("GetByID", mock.Anything, mock.Anything).Return(worker, nil)
	checkRepo.On("ReassignByWorkerID", mock.Anything, mock.Anything).Return(2, nil)
	workerRepo.On("Delete", mock.Anything, mock.Anything).Return(nil)
	auditRepo.On("Create", mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil)

	err := svc.UnregisterWorker(context.Background(), worker.ID)

	require.NoError(t, err)
	workerRepo.AssertCalled(t, "Delete", mock.Anything, mock.Anything)
}

func TestUnregisterWorker_not_found(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	workerRepo.On("GetByID", mock.Anything, mock.Anything).Return(nil, errors.New("not found"))

	err := svc.UnregisterWorker(context.Background(), uuid.New())

	assert.ErrorIs(t, err, model.ErrWorkerNotFound)
}

