func newTestWorkerService(t *testing.T) (*WorkerService, *mockWorkerRepo, *mockCheckRepo, *mockAuditRepo) {
	t.Helper()
	workerRepo := &mockWorkerRepo{}
	checkRepo := &mockCheckRepo{}
	auditRepo := &mockAuditRepo{}
	logger := slog.Default()
	svc := NewWorkerService(workerRepo, checkRepo, auditRepo, 30*time.Second, 10*time.Minute, logger)
	return svc, workerRepo, checkRepo, auditRepo
}

func TestRegisterWorker(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, auditRepo := newTestWorkerService(t)

	workerRepo.On("GetByName", mock.Anything, "worker-msk-01").Return(nil, errors.New("not found"))
	workerRepo.On("Create", mock.Anything, mock.Anything).Return(nil)
	auditRepo.On("Create", mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything, mock.Anything).Return(nil)

	worker, err := svc.RegisterWorker(context.Background(), "worker-msk-01", "moscow", map[string]string{"version": "1.0.0"})

	require.NoError(t, err)
	assert.Equal(t, "worker-msk-01", worker.Name)
	assert.Equal(t, "moscow", worker.Zone)
	assert.Equal(t, "1.0.0", worker.Metadata["version"])
	workerRepo.AssertCalled(t, "Create", mock.Anything, mock.Anything)
}

func TestRegisterWorker_duplicate_name(t *testing.T) {
	t.Parallel()

	svc, workerRepo, _, _ := newTestWorkerService(t)
	existing := model.NewWorker("worker-msk-01", "msk")
	workerRepo.On("GetByName", mock.Anything, "worker-msk-01").Return(existing, nil)

	_, err := svc.RegisterWorker(context.Background(), "worker-msk-01", "msk", nil)

	assert.ErrorIs(t, err, model.ErrWorkerNameExists)
	workerRepo.AssertNotCalled(t, "Create")
}

func TestRegisterWorker_empty_name(t *testing.T) {
	t.Parallel()

	svc, _, _, _ := newTestWorkerService(t)

	_, err := svc.RegisterWorker(context.Background(), "", "msk", nil)

	assert.ErrorIs(t, err, model.ErrWorkerNameRequired)
}

func TestRegisterWorker_whitespace_name(t *testing.T) {
	t.Parallel()

	svc, _, _, _ := newTestWorkerService(t)

	_, err := svc.RegisterWorker(context.Background(), "   ", "msk", nil)

	assert.ErrorIs(t, err, model.ErrWorkerNameRequired)
}

func TestRegisterWorker_name_too_long(t *testing.T) {
	t.Parallel()

	svc, _, _, _ := newTestWorkerService(t)
	longName := string(make([]byte, 256))

	_, err := svc.RegisterWorker(context.Background(), longName, "msk", nil)

	assert.ErrorIs(t, err, model.ErrWorkerNameTooLong)
}

func TestRegisterWorker_empty_zone(t *testing.T) {
	t.Parallel()

	svc, _, _, _ := newTestWorkerService(t)

