func TestCompleteCheck_success(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	check := model.NewScheduledCheck(uuid.New(), model.PriorityNormal, time.Now())
	check.Assign(uuid.New())
	checkRepo := &mockCheckRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, nil, nil, nil, 2*time.Minute, logger)

	checkRepo.On("GetByID", mock.Anything, mock.Anything).Return(check, nil)
	checkRepo.On("Update", mock.Anything, mock.Anything).Return(nil)

	err := svc.CompleteCheck(ctx, check.ID, false, "")

	require.NoError(t, err)
	assert.Equal(t, model.CheckStatusCompleted, check.Status)
}

func TestCompleteCheck_failed(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	check := model.NewScheduledCheck(uuid.New(), model.PriorityNormal, time.Now())
	check.Assign(uuid.New())
	checkRepo := &mockCheckRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, nil, nil, nil, 2*time.Minute, logger)

	checkRepo.On("GetByID", mock.Anything, mock.Anything).Return(check, nil)
	checkRepo.On("Update", mock.Anything, mock.Anything).Return(nil)

	err := svc.CompleteCheck(ctx, check.ID, true, "connection refused")

	require.NoError(t, err)
	assert.Equal(t, model.CheckStatusFailed, check.Status)
	assert.Equal(t, "connection refused", check.ErrorMessage)
}

func TestTriggerScheduledCheck_paused_monitor(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	workerRepo := &mockWorkerRepo{}
	auditRepo := &mockAuditRepo{}
	monitorClient := &mockMonitorClientForScheduler{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, auditRepo, monitorClient, 2*time.Minute, logger)

	monitorClient.On("IsMonitorPaused", mock.Anything, mock.Anything).Return(true, nil)

	monitorID := uuid.New()
	_, err := svc.TriggerScheduledCheck(ctx, monitorID, model.PriorityHigh)

	assert.ErrorIs(t, err, model.ErrCheckAlreadyPending)
}

func TestTriggerScheduledCheck_monitor_not_found(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	checkRepo := &mockCheckRepo{}
	workerRepo := &mockWorkerRepo{}
	auditRepo := &mockAuditRepo{}
	monitorClient := &mockMonitorClientForScheduler{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, auditRepo, monitorClient, 2*time.Minute, logger)

	monitorClient.On("IsMonitorPaused", mock.Anything, mock.Anything).Return(false, fmt.Errorf("not found"))

	monitorID := uuid.New()
	_, err := svc.TriggerScheduledCheck(ctx, monitorID, model.PriorityHigh)

	assert.ErrorIs(t, err, model.ErrMonitorNotFound)
}

func TestReassignOverdueChecks_success(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	check := model.NewScheduledCheck(uuid.New(), model.PriorityNormal, time.Now().Add(-5*time.Minute))
	checkRepo := &mockCheckRepo{}
	worker := model.NewWorker("worker-01", "msk")
	workerRepo := &mockWorkerRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, nil, nil, 2*time.Minute, logger)

	checkRepo.On("ListOverdue", mock.Anything, mock.Anything).Return([]*model.ScheduledCheck{check}, nil)
	workerRepo.On("ListIdleByZone", mock.Anything, "").Return([]*model.Worker{worker}, nil)
	checkRepo.On("Update", mock.Anything, mock.Anything).Return(nil)

	count, err := svc.ReassignOverdueChecks(ctx)

	require.NoError(t, err)
	assert.Equal(t, 1, count)
}

func TestReassignOverdueChecks_no_workers(t *testing.T) {
	t.Parallel()

	ctx := context.Background()
	check := model.NewScheduledCheck(uuid.New(), model.PriorityNormal, time.Now().Add(-5*time.Minute))
	checkRepo := &mockCheckRepo{}
	workerRepo := &mockWorkerRepo{}
	logger := slog.Default()
	svc := NewCheckScheduler(checkRepo, workerRepo, nil, nil, 2*time.Minute, logger)

	checkRepo.On("ListOverdue", mock.Anything, mock.Anything).Return([]*model.ScheduledCheck{check}, nil)
	workerRepo.On("ListIdleByZone", mock.Anything, "").Return([]*model.Worker{}, nil)

	count, err := svc.ReassignOverdueChecks(ctx)

	require.NoError(t, err)
	assert.Equal(t, 0, count)
}

type mockMonitorClientForScheduler struct {
	mock.Mock
}

func (m *mockMonitorClientForScheduler) GetMonitor(ctx context.Context, _ string) (*monitor.MonitorInfo, error) {
	args := m.Called(ctx)
	if args.Get(0) == nil {
		return nil, args.Error(1)
	}
	return args.Get(0).(*monitor.MonitorInfo), args.Error(1)
}

func (m *mockMonitorClientForScheduler) ListActiveMonitors(ctx context.Context, _ int) ([]*monitor.MonitorInfo, error) {
	args := m.Called(ctx)
	return args.Get(0).([]*monitor.MonitorInfo), args.Error(1)
}

func (m *mockMonitorClientForScheduler) IsMonitorPaused(ctx context.Context, _ string) (bool, error) {
	args := m.Called(ctx)
	return args.Get(0).(bool), args.Error(1)
}
