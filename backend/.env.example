# ========================================
# Milan Monitoring Service - Environment Variables
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ========================================
# Shared Infrastructure
# ========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milan
DB_USER=postgres
DB_PASSWORD=change_this_password
DB_SSL_MODE=require

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Authentication
JWT_SECRET=change_this_secret_key_at_least_32_characters
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h

# OpenTelemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=milan-monitoring
OTEL_LOG_LEVEL=info

# ========================================
# API Gateway Configuration
# ========================================

API_GATEWAY_SERVER_PORT=8080
API_GATEWAY_GRPC_PORT=9090
API_GATEWAY_RATE_LIMIT_REQUESTS_PER_SECOND=100
API_GATEWAY_RATE_LIMIT_BURST=200

# ========================================
# Monitor Service Configuration
# ========================================

MONITOR_SERVICE_PORT=9091

# Monitor Limits by Tier
MONITOR_LIMIT_FREE=25
MONITOR_LIMIT_STARTER=50
MONITOR_LIMIT_PROFESSIONAL=150
MONITOR_LIMIT_BUSINESS=500

# Minimum Check Intervals by Tier (seconds)
MONITOR_INTERVAL_MIN_FREE=300
MONITOR_INTERVAL_MIN_STARTER=120
MONITOR_INTERVAL_MIN_PROFESSIONAL=60
MONITOR_INTERVAL_MIN_BUSINESS=30

# ========================================
# Alert Service Configuration
# ========================================

ALERT_SERVICE_PORT=9092

# RabbitMQ Queues
ALERT_QUEUE=alerts.queue
ALERT_DLQ=alerts.dlq
NOTIFICATION_QUEUE=notifications.queue

# Rate Limiting
ALERT_RATE_LIMIT_PER_MONITOR=1 per 5 minutes
ALERT_RATE_LIMIT_DAILY_PER_USER=100

# Retry Configuration
ALERT_RETRY_MAX_ATTEMPTS=3
ALERT_RETRY_INITIAL_DELAY=1s
ALERT_RETRY_MAX_DELAY=60s

# SMTP Configuration (Email Alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@milan.ru

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_telegram
TELEGRAM_API_URL=https://api.telegram.org

# Webhook Configuration
WEBHOOK_TIMEOUT=10s
WEBHOOK_RETRY_MAX_ATTEMPTS=3

# ========================================
# Billing Service Configuration
# ========================================

BILLING_SERVICE_PORT=9093

# Yandex Kassa (Yookassa) Configuration
YANDEX_SHOP_ID=your_shop_id
YANDEX_SECRET_KEY=your_secret_key
YANDEX_API_URL=https://api.yookassa.ru/v3
YANDEX_WEBHOOK_SECRET=your_webhook_secret

# Subscription Pricing (in kopeks)
SUBSCRIPTION_PRICE_FREE=0
SUBSCRIPTION_PRICE_STARTER=50000      # 500₽
SUBSCRIPTION_PRICE_PROFESSIONAL=250000 # 2500₽
SUBSCRIPTION_PRICE_BUSINESS=750000    # 7500₽

# Webhook Configuration
BILLING_WEBHOOK_QUEUE=payment.webhooks

# ========================================
# Scheduler Service Configuration
# ========================================

SCHEDULER_SERVICE_PORT=9094

# Scheduling Configuration
SCHEDULER_BATCH_SIZE=100
SCHEDULER_LOOK_AHEAD_MINUTES=5

# Worker Registration
SCHEDULER_HEARTBEAT_INTERVAL=30s
SCHEDULER_WORKER_TIMEOUT=60s

# ========================================
# Check Worker Configuration
# ========================================

# Scheduler Connection
SCHEDULER_ADDRESS=scheduler-service:9094
MONITOR_SERVICE_ADDRESS=monitor-service:9091

# Check Configuration
CHECK_TIMEOUT_SECONDS=10
CHECK_MAX_REDIRECTS=5
CHECK_USER_AGENT=Milan Monitor/1.0
CHECK_POLL_INTERVAL=10s

# Response Size Limit
CHECK_MAX_RESPONSE_SIZE_MB=1

# ========================================
# Database Connection Pool Configuration
# ========================================

DB_MAX_OPEN_CONNECTIONS=25
DB_MAX_IDLE_CONNECTIONS=5
DB_CONNECTION_MAX_LIFETIME=5m
DB_CONNECTION_MAX_IDLE_TIME=1m

# ========================================
# RabbitMQ Connection Configuration
# ========================================

RABBITMQ_EXCHANGE=monitors
RABBITMQ_CONNECTION_TIMEOUT=30s
RABBITMQ_HEARTBEAT=10s

# ========================================
# Monitoring & Alerting
# ========================================

# Prometheus Metrics
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9095

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=5s

# ========================================
# External Services
# ========================================

# Yandex Cloud (152-FZ Compliant)
YANDEX_CLOUD_ENABLED=false
YANDEX_CLOUD_FOLDER_ID=

# Timeweb Cloud (152-FZ Compliant)
TIMEWEB_CLOUD_ENABLED=false
TIMEWEB_CLOUD_API_KEY=

# ========================================
# Development Settings
# ========================================

# Debug Mode
DEBUG=false
DEBUG_LOG_LEVEL=debug

# Test Mode
TEST_MODE=false

# ========================================
# Grafana Configuration
# ========================================

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_USERS_ALLOW_SIGN_UP=false
