# Server
SERVER_ADDRESS=:50051
SERVER_TIMEOUT=30s

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=monitor
DB_PASSWORD=monitor
DB_NAME=notification_templates
DB_SSLMODE=disable

# Migrations
MIGRATIONS_PATH=./migrations

# Observability
JAEGER_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
ENVIRONMENT=development

# Template settings
MAX_TEMPLATE_SIZE=100000
ENABLE_PREVIEW=true
